#!/usr/bin/env python3
"""
SeRTial Schema Inspector (CLI)

Terminal-based inspection and visualization of message schemas.
"""

import sys
import argparse
from pathlib import Path

# Add scripts directory to path for imports
sys.path.insert(0, str(Path(__file__).parent))

from sertial_common import SchemaLoader
from sertial_cli import CLIRenderer


def main():
    parser = argparse.ArgumentParser(
        description='Visualize SeRTial message schemas in the terminal',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Examples:
  %(prog)s schemas.json --summary
  %(prog)s schemas.json --message Header
  %(prog)s schemas.json --all
  %(prog)s schemas.json --no-color --summary
        '''
    )
    
    parser.add_argument('schema_file', help='Path to JSON schema file')
    parser.add_argument('--summary', action='store_true',
                       help='Show summary table of all messages')
    parser.add_argument('--message', metavar='NAME',
                       help='Show detailed view of specific message')
    parser.add_argument('--all', action='store_true',
                       help='Show detailed view of all messages')
    parser.add_argument('--no-color', action='store_true',
                       help='Disable colored output')
    parser.add_argument('--category', metavar='CAT',
                       help='Filter messages by category')
    
    args = parser.parse_args()
    
    # Load schemas
    try:
        messages = SchemaLoader.load_all_messages(args.schema_file)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"Error loading schemas: {e}", file=sys.stderr)
        return 1
    
    if not messages:
        print("No messages found in schema file", file=sys.stderr)
        return 1
    
    # Filter by category if specified
    if args.category:
        messages = [m for m in messages if m.category == args.category]
        if not messages:
            print(f"No messages found in category: {args.category}", file=sys.stderr)
            return 1
    
    # Create renderer
    renderer = CLIRenderer(use_color=not args.no_color)
    
    # Execute command
    if args.summary or (not args.message and not args.all):
        # Default to summary if no specific action
        renderer.print_summary(messages)
    
    if args.message:
        # Find and display specific message
        found = [m for m in messages if m.name == args.message]
        if not found:
            print(f"Message not found: {args.message}", file=sys.stderr)
            print(f"Available messages: {', '.join(m.name for m in messages)}", file=sys.stderr)
            return 1
        renderer.visualize_message(found[0])
    
    if args.all:
        # Display all messages
        for msg in messages:
            renderer.visualize_message(msg)
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
